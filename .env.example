# =====================================================================
#  SOLAR - konfigurasi
#  Salin file ini menjadi `.env` (di root repo) lalu isi nilainya.
#  Aplikasi desktop memakai %APPDATA%\SOLAR\.env (dibuat otomatis).
#  Nilai kosong = pakai default. Jangan commit file .env ke Git.
# =====================================================================

# --- Model AI --------------------------------------------------------
# Provider lain (OmniRoute, OpenRouter, LiteLLM, Claude, Gemini, Ollama, ...) dan
# urutan model utama/cadangan diatur di aplikasi: Pengaturan -> Model AI
# (disimpan di data/llm.json). API key di sana boleh berupa referensi ${NAMA_VARIABEL}
# ke variabel di file ini, mis. OMNIROUTE_API_KEY=... lalu isi ${OMNIROUTE_API_KEY}.
#
# Provider "openai" bawaan (dipakai bila belum ada rute lain):
# buat key di https://platform.openai.com/api-keys (butuh saldo/billing API;
# langganan ChatGPT Plus/Pro tidak termasuk kredit API).
OPENAI_API_KEY=
# Opsional: organisasi / project OpenAI, atau endpoint kompatibel (mis. proxy perusahaan)
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=
# Model & tingkat usaha penalaran (none | minimal | low | medium | high | xhigh | max;
# tidak semua model mendukung semua nilai - gpt-6.1-sol: low s.d. max)
SOLAR_MODEL=gpt-6.1-sol
SOLAR_EFFORT=high
# Batas output per giliran (termasuk token penalaran) dan jumlah giliran per task
SOLAR_MAX_TOKENS=64000
SOLAR_MAX_TURNS=40
# Opsional: harga untuk estimasi biaya di monitor, USD per 1 juta token
# "input,cached_input,output" - kosong = tabel harga bawaan
SOLAR_PRICE_PER_MTOK=

# --- Knowledge base ----------------------------------------------------
# Folder file Markdown aturan & fakta Anda (sistem, integrasi, standar).
# Kosong = data/knowledge. Boleh diarahkan ke clone repository Git sendiri.
KNOWLEDGE_DIR=

# --- Server ----------------------------------------------------------
PORT=8790
# 127.0.0.1 = hanya komputer ini. Pakai 0.0.0.0 untuk akses dari jaringan
# (WAJIB isi SOLAR_ACCESS_TOKEN jika demikian). Aplikasi desktop selalu 127.0.0.1.
HOST=127.0.0.1
# Token API untuk skrip/CI/integrasi (header "Authorization: Bearer <token>", atau
# ?token=<token> untuk event stream & unduhan): bertindak sebagai superadmin, bukan akun.
# Pengguna di browser TIDAK memakainya - mereka masuk dengan username/email + password.
# Wajib bila SOLAR dibuka dengan nama host lain (HOST=0.0.0.0 atau reverse proxy);
# tanpa token, API hanya melayani 127.0.0.1/localhost. Token yang dikirim tetapi salah
# -> 401 invalid_token. Buat token acak yang panjang, mis.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Juga jalan pemulihan bila tidak ada superadmin yang bisa masuk (lihat README,
# "Akun, login & peran"). Ganti token = ubah nilai ini lalu restart.
SOLAR_ACCESS_TOKEN=

# --- Akun & login ----------------------------------------------------------
# Superadmin pertama, dibuat saat server start HANYA bila belum ada akun sama sekali.
# Bila sudah ada akun, nilai ini diabaikan (tidak mereset password, tidak membuat akun
# baru). USERNAME, EMAIL dan PASSWORD wajib diisi bersama; NAME opsional (default =
# username). Username 3-32 karakter: huruf a-z, angka, . _ - (disimpan huruf kecil).
# Password 10-128 karakter, tidak sama dengan username/email. Nilai yang tidak valid
# membuat server gagal start.
# Tanpa ini, superadmin pertama dibuat di layar SOLAR dengan kode penyiapan sekali
# pakai: aplikasi desktop mengisinya otomatis; di server, kodenya dicetak di log saat
# start dan disimpan di DATA_DIR/setup-code.txt (desktop:
# %APPDATA%\SOLAR\data\setup-code.txt), dan form itu hanya diterima dari komputer
# server itu sendiri. Cara ketiga: POST /api/auth/setup dengan SOLAR_ACCESS_TOKEN
# (lihat docs/API.md).
# Setelah masuk pertama kali, ganti password lalu kosongkan SOLAR_ADMIN_PASSWORD di sini.
SOLAR_ADMIN_USERNAME=
SOLAR_ADMIN_EMAIL=
SOLAR_ADMIN_PASSWORD=
SOLAR_ADMIN_NAME=
# Sesi login (cookie HttpOnly solar_session) berakhir setelah sekian jam tidak dipakai
# (default 168 = 7 hari; boleh pecahan, mis. 0.5 = 30 menit)...
SESSION_TTL_HOURS=168
# ...dan paling lama sekian hari sejak login, walau terus dipakai (default 30; maks. 365).
# Setelah itu pengguna masuk lagi.
SESSION_MAX_DAYS=30
# Reverse proxy (nginx, Caddy, Traefik, ...) di depan SOLAR: jumlah hop proxy yang
# dipercaya (true = 1, atau 1-9; kosong/false = tanpa proxy). Dengan ini
# X-Forwarded-For/-Proto/-Host dipakai untuk IP klien (batas percobaan login per
# pengguna, bukan per proxy), cookie Secure di HTTPS dan cek Origin.
# Jangan di-set tanpa proxy: klien bisa memalsukan header itu. Selama di-set, form
# superadmin pertama dengan kode penyiapan tidak tersedia - pakai SOLAR_ADMIN_* di atas.
TRUST_PROXY=
# Jumlah task yang dikerjakan bersamaan
TASK_CONCURRENCY=2
# Ukuran maksimum satu dokumen lampiran (MB) - PDF, Word, Excel, PowerPoint, Markdown, teks
ATTACHMENT_MAX_MB=25
# Batas waktu menunggu persetujuan Anda (menit) sebelum aksi dibatalkan
CONFIRMATION_TIMEOUT_MINUTES=60
# Log aktivitas (audit: login, pendaftaran, akun, task, persetujuan, knowledge, skill,
# pengaturan): entri yang lebih tua dari sekian hari dihapus otomatis (saat server start
# lalu setiap hari). Default 365; 0 = simpan selamanya; maks. 36500.
# Tanpa DATABASE_URL disimpan di data/activity/, dengan Neon di tabel solar_activity.
ACTIVITY_RETENTION_DAYS=365
LOG_LEVEL=info

# --- Neon Postgres (opsional) ------------------------------------------
# Kosong = task & riwayat disimpan sebagai file di folder data/.
# Contoh: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Tabel (task, akun, sesi, peran, log aktivitas, ...) dibuat/diperbarui otomatis saat server start.
# Butuh Postgres 13 atau lebih baru (Neon memenuhi). Skema lengkapnya: docs/schema.sql,
# atau cetak dengan `npm run -s db:schema`. Akun di penyimpanan file (data/users.json)
# tidak ikut pindah ke database baru: buat superadmin pertama lagi.
DATABASE_URL=

# --- Object storage S3-compatible untuk artefak (opsional) --------------
# Neon object storage / AWS S3 / Cloudflare R2 / MinIO.
# Kosong = artefak disimpan di data/artifacts.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=solar/

# --- GitHub (plugin MCP GitHub + publish artefak) -------------------------
# Fine-grained personal access token: Contents (read/write), Pull requests,
# Issues, Metadata untuk repository yang dipakai.
GITHUB_TOKEN=
# Repository default untuk publish artefak, format owner/nama-repo
GITHUB_DEFAULT_REPO=
GITHUB_DEFAULT_BRANCH=main
# never = langsung commit saat diminta | always = minta konfirmasi dulu
GITHUB_PUBLISH_CONFIRM=never

# --- Plane - backlog di plane.mesthi.com ---------------------------------
PLANE_API_HOST_URL=https://plane.mesthi.com
# Workspace Settings > API Tokens
PLANE_API_KEY=
# Slug workspace (bagian URL setelah domain, mis. https://plane.mesthi.com/<slug>/)
PLANE_WORKSPACE_SLUG=
# UUID project yang dipakai sebagai backlog (opsional; jika kosong SOLAR menampilkan daftar project)
PLANE_PROJECT_ID=
# never | always
PLANE_CONFIRM=never

# --- Visual Paradigm (plugin MCP, SETIAP pemanggilan wajib konfirmasi) -----
# URL endpoint MCP (Streamable HTTP) yang terhubung ke Visual Paradigm Anda.
VP_MCP_URL=
VP_MCP_TOKEN=
