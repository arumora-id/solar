# =====================================================================
#  SOLAR - konfigurasi
#  Salin file ini menjadi `.env` (di root repo) lalu isi nilainya.
#  Aplikasi desktop memakai %APPDATA%\SOLAR\.env (dibuat otomatis).
#  Nilai kosong = pakai default. Jangan commit file .env ke Git.
# =====================================================================

# --- WAJIB: OpenAI API (API key ChatGPT) --------------------------------
# Buat di https://platform.openai.com/api-keys (butuh saldo/billing API;
# langganan ChatGPT Plus/Pro tidak termasuk kredit API).
OPENAI_API_KEY=
# Opsional: organisasi / project OpenAI, atau endpoint kompatibel (mis. proxy perusahaan)
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=
# Model & tingkat usaha penalaran (none | minimal | low | medium | high | xhigh | max;
# tidak semua model mendukung semua nilai - gpt-6.1-sol: low s.d. max)
SOLAR_MODEL=gpt-6.1-sol
SOLAR_EFFORT=high
# Batas output per giliran (termasuk token penalaran) dan jumlah giliran per task
SOLAR_MAX_TOKENS=64000
SOLAR_MAX_TURNS=40
# Opsional: harga untuk estimasi biaya di monitor, USD per 1 juta token
# "input,cached_input,output" - kosong = tabel harga bawaan
SOLAR_PRICE_PER_MTOK=

# --- Server ----------------------------------------------------------
PORT=8790
# 127.0.0.1 = hanya komputer ini. Pakai 0.0.0.0 untuk akses dari jaringan
# (WAJIB isi SOLAR_ACCESS_TOKEN jika demikian).
HOST=127.0.0.1
SOLAR_ACCESS_TOKEN=
# Jumlah task yang dikerjakan bersamaan
TASK_CONCURRENCY=2
# Ukuran maksimum satu dokumen lampiran (MB) - PDF, Word, Excel, PowerPoint, Markdown, teks
ATTACHMENT_MAX_MB=25
# Batas waktu menunggu persetujuan Anda (menit) sebelum aksi dibatalkan
CONFIRMATION_TIMEOUT_MINUTES=60
LOG_LEVEL=info

# --- Neon Postgres (opsional) ------------------------------------------
# Kosong = task & riwayat disimpan sebagai file di folder data/.
# Contoh: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Object storage S3-compatible untuk artefak (opsional) --------------
# Neon object storage / AWS S3 / Cloudflare R2 / MinIO.
# Kosong = artefak disimpan di data/artifacts.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=solar/

# --- GitHub (plugin MCP GitHub + publish artefak) -------------------------
# Fine-grained personal access token: Contents (read/write), Pull requests,
# Issues, Metadata untuk repository yang dipakai.
GITHUB_TOKEN=
# Repository default untuk publish artefak, format owner/nama-repo
GITHUB_DEFAULT_REPO=
GITHUB_DEFAULT_BRANCH=main
# never = langsung commit saat diminta | always = minta konfirmasi dulu
GITHUB_PUBLISH_CONFIRM=never

# --- Plane - backlog di plane.mesthi.com ---------------------------------
PLANE_API_HOST_URL=https://plane.mesthi.com
# Workspace Settings > API Tokens
PLANE_API_KEY=
# Slug workspace (bagian URL setelah domain, mis. https://plane.mesthi.com/<slug>/)
PLANE_WORKSPACE_SLUG=
# UUID project yang dipakai sebagai backlog (opsional; jika kosong SOLAR menampilkan daftar project)
PLANE_PROJECT_ID=
# never | always
PLANE_CONFIRM=never

# --- Visual Paradigm (plugin MCP, SETIAP pemanggilan wajib konfirmasi) -----
# URL endpoint MCP (Streamable HTTP) yang terhubung ke Visual Paradigm Anda.
VP_MCP_URL=
VP_MCP_TOKEN=
